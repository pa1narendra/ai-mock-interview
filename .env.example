# ---------------------------------------------------------------
# Neon Postgres (https://neon.tech - free tier, no card required)
# Project dashboard > Connection string (pooled)
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Better Auth
# Generate a secret with:  npx @better-auth/cli secret
# BETTER_AUTH_URL is your app origin (http://localhost:3000 in dev)
# ---------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------
# Optional: Google OAuth ("Continue with Google")
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# If unset, the Google button on the sign-in page will error; email/password
# sign-in still works.
# ---------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------
# Google Gemini API key (SERVER-ONLY) - https://aistudio.google.com/apikey
# Used for question generation, report scoring, and minting the
# short-lived tokens the browser uses for live voice interviews.
# ---------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the Gemini Live voice model (preview model names rotate)
# Default: gemini-3.1-flash-live-preview
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Optional: email sending for password resets (https://resend.com - free tier).
# Without it, reset links are logged to the server console (dev only).
# RESEND_API_KEY=
# EMAIL_FROM="Mockstar <onboarding@resend.dev>"

# Optional: require new accounts to verify their email before signing in.
# Needs RESEND_API_KEY with a verified sending domain, or real users never
# get the link. Read on both server and client, so it must be NEXT_PUBLIC_.
# NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=true

# Optional: the admin account. This email gets every permission plus the
# /admin page (grant or remove Pro). Leave unset for no admin.
# OWNER_EMAIL=pavan@gmail.com

# Optional: demo accounts for live pitches (comma-separated). They get Pro
# with no usage caps, but no admin access. Remove an email to switch it off.
# DEMO_EMAILS=demo@example.com

# Optional: open-model safety net (https://console.groq.com - free tier).
# When set, text generation falls back to Llama on Groq if both Gemini
# models are unavailable. Never used for resume PDF reading.
# GROQ_API_KEY=
